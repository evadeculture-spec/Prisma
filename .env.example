# Supabase project URL and anon key — safe to expose to the browser.
# Find these in your Supabase project under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, bypasses Row Level Security. Never
# expose this to the browser. Only used by lib/supabase/admin.ts (trusted
# server actions like team invites) and by scripts/seed.ts (demo data).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
